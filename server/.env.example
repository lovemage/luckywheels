# Database
DATABASE_URL=postgresql://lucky:lucky@127.0.0.1:5433/luckywheels

# Test database — REQUIRED for safe testing.
# Tests truncate tables aggressively; pointing them at the production
# DB will destroy real data. Use a separate Postgres (local docker, or
# a dedicated Railway DB). If TEST_DATABASE_URL is set, vitest's
# tests/setup.ts overrides DATABASE_URL with this value automatically.
# TEST_DATABASE_URL=postgresql://lucky:lucky@127.0.0.1:5433/luckywheels_test

# Server
PORT=3001
PUBLIC_FRONTEND_ORIGIN=http://127.0.0.1:5173

# Secrets (each must be ≥ 32 bytes, base64 or hex; rotate independently)
JWT_SECRET=replace-me-min-32-bytes-XXXXXXXXXXXXXX
STATE_SECRET=different-32-byte-secret-for-oauth-state-XXXXXX
JWT_ISSUER=luckywheels
JWT_AUDIENCE=luckywheels-front

# LINE Login
LINE_CHANNEL_ID=xxxxxxxxxx
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_REDIRECT_URI=http://127.0.0.1:3001/api/auth/line/callback
LINE_AUTH_BASE=https://access.line.me/oauth2/v2.1
LINE_API_BASE=https://api.line.me/oauth2/v2.1
LINE_PROFILE_BASE=https://api.line.me/v2
LINE_ISSUER=https://access.line.me

# Admin
ADMIN_JWT_SECRET=another-32-byte-secret-for-admin-session-XXX
ADMIN_PUBLIC_ORIGIN=http://127.0.0.1:5174

# Railway Bucket (S3-compatible) — for admin image uploads.
# When this service is referenced from the bucket service on Railway,
# all 5 vars are auto-injected. For local dev, leaving them unset is
# fine — upload endpoints will return BUCKET_NOT_CONFIGURED.
# BUCKET=
# ACCESS_KEY_ID=
# SECRET_ACCESS_KEY=
# ENDPOINT=https://storage.railway.app
# REGION=auto

# ---------------------------------------------------------------------------
# Superadmin service (a SEPARATE Railway deployment, Dockerfile.superadmin).
# Only set these on that service — the normal member/admin server ignores them.
# It connects to BOTH site databases at once and reviews registrations across
# them. All optional so the normal server / tests boot without them.
# ---------------------------------------------------------------------------
# Connection strings for the two site databases (reference the two Postgres
# services on Railway). Same prisma schema, two separate datasets.
# SITE_A_DATABASE_URL=postgresql://...site-a...
# SITE_B_DATABASE_URL=postgresql://...site-b...
# Dedicated session secret (>=32 bytes, MUST differ from the other secrets).
# SUPERADMIN_JWT_SECRET=yet-another-32-byte-secret-XXXXXXXXXXXXXX
# Which site's DB stores the superadmin AdminUser rows (role='superadmin'). Default A.
# SUPERADMIN_CONTROL_SITE=A
# Friendly labels shown in the console for each site (default 'A 站' / 'B 站').
# SITE_A_LABEL=甲站
# SITE_B_LABEL=乙站
# Local superadmin dev runs on a different port so it doesn't clash with 3001:
#   PORT=3002 npm run superadmin:dev
