<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:type="linear" android:angle="315"
                android:startColor="#FFFFE3A6" android:centerColor="#FFE8C274" android:endColor="#FFB9852F" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <stroke android:width="1dp" android:color="#66FFF6D8" />
        </shape>
    </item>
</layer-list>
