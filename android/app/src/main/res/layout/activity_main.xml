<?xml version="1.0" encoding="utf-8"?>
<!-- 遊戲（全螢幕 WebView）在最底層；助手面板與懸浮按鈕疊在上面 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <WebView
        android:id="@+id/gameWeb"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ProgressBar
        android:id="@+id/gameProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="@color/gold"
        android:progressBackgroundTint="@android:color/transparent"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/gameError"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/game_error_title"
            android:textColor="@color/gold"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/game_error_body"
            android:textColor="@color/muted"
            android:textSize="15sp" />

        <Button
            android:id="@+id/gameRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/collapse_btn_bg"
            android:minHeight="48dp"
            android:paddingHorizontal="28dp"
            android:text="@string/retry"
            android:textColor="@color/gold"
            android:textSize="16sp" />
    </LinearLayout>

    <View
        android:id="@+id/scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/scrim"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/panel_bg"
        android:elevation="12dp"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/panelHeader"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:contentDescription="@null"
                android:src="@drawable/brand_star" />

            <TextView
                android:id="@+id/panelTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/panel_title"
                android:textColor="@color/gold_hi"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/panelCollapse"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/collapse_btn_bg"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/panel_collapse"
                android:textColor="@color/gold"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/line" />

        <WebView
            android:id="@+id/panelWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <ImageView
        android:id="@+id/bubble"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bubble_bg"
        android:contentDescription="@string/bubble_desc"
        android:elevation="10dp"
        android:padding="14dp"
        android:src="@drawable/bubble_star" />
</FrameLayout>
